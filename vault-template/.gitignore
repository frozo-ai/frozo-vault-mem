# Re-include the empty audit.log starter (root .gitignore has *.log
# which would otherwise hide it from git, breaking init on fresh clones).
!_system/audit.log

# FTS index — rebuildable from .md sources
_system/index.sqlite
_system/index.sqlite-wal
_system/index.sqlite-shm

# Embedding index — rebuildable from .md sources
_system/embeddings.lance/

# Daemon-managed; rebuilt every keeper run
_system/links.jsonl
