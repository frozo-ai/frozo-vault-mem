{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "vault-mem://schema/entity.json",
  "allOf": [
    { "$ref": "_common.json" },
    {
      "type": "object",
      "properties": {
        "type": { "const": "entity" },
        "entity_kind": {
          "type": "string",
          "enum": ["person", "project", "tool", "concept"]
        }
      },
      "required": ["type", "entity_kind"]
    }
  ]
}
