<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Env-file variant of com.vaultmem.keeper.plist.

  No API keys live in this plist. The wrapper script
  packages/keeper/bin/run-keeper.sh sources $VAULT_MEM_KEEPER_ENV
  (default: ~/.config/vault-mem/keeper.env) at start.

  Setup:
    mkdir -p ~/.config/vault-mem
    cat > ~/.config/vault-mem/keeper.env <<EOF
    OPENROUTER_API_KEY=sk-or-...
    # or:
    # ANTHROPIC_API_KEY=sk-ant-...
    EOF
    chmod 600 ~/.config/vault-mem/keeper.env

  Then edit this plist (replace REPLACE_USER + the path), copy to
  ~/Library/LaunchAgents/, and `launchctl load -w ...`.
-->
<plist version="1.0">
<dict>
  <key>Label</key>            <string>com.vaultmem.keeper</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/REPLACE_USER/path/to/frozo-vault-mem/packages/keeper/bin/run-keeper.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>VAULT_MEM_PATH</key>          <string>/Users/REPLACE_USER/vault-mem</string>
    <!-- Override the default env-file location if you keep secrets elsewhere: -->
    <!-- <key>VAULT_MEM_KEEPER_ENV</key>    <string>/Users/REPLACE_USER/.config/vault-mem/keeper.env</string> -->
    <!-- launchd jobs run with a minimal PATH; uv usually lives in ~/.local/bin: -->
    <key>PATH</key>                    <string>/Users/REPLACE_USER/.local/bin:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
  </dict>
  <key>StartInterval</key>    <integer>1800</integer>
  <key>StandardErrorPath</key><string>/Users/REPLACE_USER/Library/Logs/vault-mem-keeper.err.log</string>
  <key>StandardOutPath</key>  <string>/Users/REPLACE_USER/Library/Logs/vault-mem-keeper.out.log</string>
  <key>RunAtLoad</key>        <false/>
</dict>
</plist>
